  },
  "zensical code block embeded": {
    "prefix": "zensical-code-embed",
    "body": [
      "!!! EXAMPLE \"${1:title}\"
    ```${2:title}
    --8<-- \"${2:url}?raw=true\"
    ```"
    ]
  },
  "zensical code block fourclojure": {
    "prefix": "zensical-code-embed-4clojure",
    "body": [
      "!!! EXAMPLE \"Design Journal - 4Clojure #${1:number}\"
    ```clojure
    --8<-- \"https://github.com/practicalli/four-clojure/blob/master/src/four_clojure/${2:filename}?raw=true\"
    ```"
    ]
  },
